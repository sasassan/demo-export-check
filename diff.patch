@@ -0,0 +1,193 @@
+"use client";
+
+import Image from "next/image";
+import { useRouter } from "next/navigation";
+import { useState } from "react";
+
+import { uploadImageAsDataUrl } from "@/lib/storage/upload";
+import type { CreateCaseSchema } from "@/lib/validation/case";
+
+const initialState: CreateCaseSchema = {
+  productName: "",
+  modelNumber: "",
+  destinationCountry: "",
+  customerCompanyName: "",
+  productImageUrl: undefined,
+};
+
+export function CaseForm() {
+  const router = useRouter();
+  const [form, setForm] = useState<CreateCaseSchema>(initialState);
+  const [submitting, setSubmitting] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+
+  async function handleFileChange(event: React.ChangeEvent<HTMLInputElement>) {
+    const file = event.target.files?.[0];
+
+    if (!file) {
+      return;
+    }
+
+    const productImageUrl = await uploadImageAsDataUrl(file);
+    setForm((current) => ({
+      ...current,
+      productImageUrl,
+    }));
+  }
+
+  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    setSubmitting(true);
+    setError(null);
+
+    try {
+      const response = await fetch("/api/cases", {
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+        },
+        body: JSON.stringify(form),
+      });
+
+      const payload = (await response.json()) as { id?: string; error?: string };
+
+      if (!response.ok || !payload.id) {
+        throw new Error(payload.error ?? "案件登録に失敗しました。");
+      }
+
+      await fetch(`/api/investigations/${payload.id}/run`, {
+        method: "POST",
+      });
+
+      router.push(`/cases/${payload.id}`);
+      router.refresh();
+    } catch (submissionError) {
+      setError(
+        submissionError instanceof Error
+          ? submissionError.message
+          : "案件登録に失敗しました。",
+      );
+    } finally {
+      setSubmitting(false);
+    }
+  }
+
+  function updateField<Key extends keyof CreateCaseSchema>(
+    key: Key,
+    value: CreateCaseSchema[Key],
+  ) {
+    setForm((current) => ({
+      ...current,
+      [key]: value,
+    }));
+  }
+
+  return (
+    <form onSubmit={handleSubmit} className="grid gap-6 lg:grid-cols-[2fr_1fr]">
+      <div className="grid gap-4 rounded-3xl border border-slate-200 bg-white p-6">
+        <div className="grid gap-4 md:grid-cols-2">
+          <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
+            商品名
+            <input
+              className="rounded-2xl border border-slate-200 px-4 py-3"
+              value={form.productName}
+              onChange={(event) => updateField("productName", event.target.value)}
+              placeholder="例: 高精度サーボモーター"
+              required
+            />
+          </label>
+          <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
+            型番
+            <input
+              className="rounded-2xl border border-slate-200 px-4 py-3"
+              value={form.modelNumber}
+              onChange={(event) => updateField("modelNumber", event.target.value)}
+              placeholder="例: SRV-9800"
+              required
+            />
+          </label>
+        </div>
+
+        <div className="grid gap-4 md:grid-cols-2">
+          <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
+            輸出先国
+            <input
+              className="rounded-2xl border border-slate-200 px-4 py-3"
+              value={form.destinationCountry}
+              onChange={(event) => updateField("destinationCountry", event.target.value)}
+              placeholder="例: ベトナム"
+              required
+            />
+          </label>
+          <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
+            顧客企業名
+            <input
+              className="rounded-2xl border border-slate-200 px-4 py-3"
+              value={form.customerCompanyName}
+              onChange={(event) =>
+                updateField("customerCompanyName", event.target.value)
+              }
+              placeholder="例: Saigon Precision Parts Ltd."
+              required
+            />
+          </label>
+        </div>
+
+        <label className="flex flex-col gap-2 text-sm font-medium text-slate-700">
+          商品画像
+          <input
+            type="file"
+            accept="image/*"
+            className="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-4 py-6"
+            onChange={handleFileChange}
+          />
+        </label>
+
+        {form.productImageUrl ? (
+          <div className="overflow-hidden rounded-3xl border border-slate-200">
+            <Image
+              src={form.productImageUrl}
+              alt="商品画像プレビュー"
+              width={1200}
+              height={480}
+              className="h-48 w-full object-cover"
+              unoptimized
+            />
+          </div>
+        ) : null}
+
+        {error ? (
+          <p className="rounded-2xl bg-red-50 px-4 py-3 text-sm text-red-700">{error}</p>
+        ) : null}
+
+        <button
+          type="submit"
+          disabled={submitting}
