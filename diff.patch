+          ))}
+        </View>
+
+        <View style={styles.section}>
+          <Text style={styles.heading}>次のアクション</Text>
+          {model.nextActions.map((action) => (
+            <Text key={action}>・{action}</Text>
+          ))}
+        </View>
+      </Page>
+    </Document>
+  );
+}
