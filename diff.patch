+          target="_blank"
+          rel="noreferrer"
+          className="inline-flex w-fit rounded-full bg-slate-950 px-5 py-3 text-sm font-medium text-white"
+        >
+          PDFを生成して開く
+        </a>
+      </section>
+    </Shell>
+  );
+}
