# --- データベース ---
# PostgreSQL接続文字列。Neon等のプール済み（-pooler付き / PgBouncer transaction mode
# 互換）接続文字列を推奨（同時リクエストでの接続枯渇を防ぐため）。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/export-risk-navigator
# アプリ側（postgres.js）の接続プール上限（任意、未設定時は5）。
# プーラー/DB側の総接続数上限を圧迫しないよう、控えめな値を推奨。
DATABASE_POOL_MAX=5
# プール内アイドル接続のタイムアウト（秒、未設定時は20）
DATABASE_IDLE_TIMEOUT_SECONDS=20
# 新規接続確立のタイムアウト（秒、未設定時は10）
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# --- AIプロバイダー APIキー（本番AIを有効にする場合は少なくとも1つ設定） ---
# OpenAI (GPT-4o) のAPIキー。取得先: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Anthropic (Claude) のAPIキー。取得先: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Google (Gemini) のAPIキー。取得先: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIza...

# --- 法人（Organization / Project）アカウント移行用（任意・現時点では全て未設定でOK） ---
# 詳細な移行手順は docs/account-migration.md を参照。

# OpenAI: Organization ID（法人アカウントでOrg単位のキーを使う場合のみ設定）。
# 未設定時はヘッダー自体を送らず、個人アカウントの動作に影響しない。
# 取得先: https://platform.openai.com/settings/organization/general
OPENAI_ORG_ID=
# OpenAI: Project ID（法人アカウントでProject単位のキーを使う場合のみ設定）。
# 取得先: https://platform.openai.com/settings/organization/projects
OPENAI_PROJECT_ID=
# OpenAI: APIのベースURL（プロキシ/Azure OpenAI経由/検証用モックサーバー等に向ける場合のみ設定）。
# 未設定時は既定の https://api.openai.com/v1 を使用。
OPENAI_BASE_URL=

# Anthropic: APIのベースURL（プロキシ/検証用モックサーバー等に向ける場合のみ設定）。
# 未設定時は既定の https://api.anthropic.com を使用。
# 注: AnthropicのAPIキーはWorkspace単位で発行時に既にスコープが確定するため、
# 追加のOrganization/Projectヘッダーは不要（docs/account-migration.md の調査結果を参照）。
ANTHROPIC_BASE_URL=

# Google: 将来Vertex AI（GCPプロジェクト+リージョン+サービスアカウント認証）へ移行する場合の予約枠。
# 現時点ではコード未実装（AI Studioキー方式のまま）。GOOGLE_CLOUD_PROJECT_ID は
# /api/ai/health の表示（project識別・マスク表示）にのみ使用され、認証には使われない。
# 詳細・利用規約上の注意点は docs/account-migration.md を参照。
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_VERTEX_LOCATION=

# --- 外部データソースAPIキー（現状は未使用・将来の拡張用プレースホルダー） ---
SANCTIONS_API_KEY=
COMPANY_INTELLIGENCE_API_KEY=
NEWS_API_KEY=

# --- アプリケーション設定 ---
# アプリの公開URL（サイトマップ・robots.txt等で使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Search Console のサイト所有権確認メタタグ（任意）。設定すると <meta name="google-site-verification"> が出力される
NEXT_PUBLIC_GSC_VERIFICATION=
# セッションCookieの署名に使う秘密鍵。本番では必ず十分な長さのランダム値に変更すること
SESSION_SECRET=dev-secret-change-in-production
# セッションCookie名
SESSION_COOKIE_NAME=ern_session_email
# 管理者権限を付与するメールアドレス（カンマ区切りで複数指定可）
ADMIN_EMAILS=demo@example.com
# 管理者メールでのログイン時に、OTP検証に加えて要求する追加パスワード（二要素化）。
# 生成例: openssl rand -base64 32
# 本番でこれが未設定の場合、管理者ログインAPIはfail-closedで拒否する。
ADMIN_PASSWORD=

# --- メール確認コード（OTP）ログイン ---
# ログイン時、入力されたメールアドレス宛に6桁のワンタイムコードを送信し、
# 検証に成功した場合のみセッションを発行する（src/app/api/auth/login,
# src/app/api/auth/verify を参照）。
# 本番でSMTPが未設定の場合、新規ログインはfail-closedで拒否される
# （検証なしのセッション発行を許可しないため）。
# Gmail想定の値: smtp.gmail.com:587（送信元はGoogleアカウントのアプリパスワードを使用）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# OTPコードのハッシュ化に使うHMAC秘密鍵（任意）。未設定時はSESSION_SECRETを流用する。
OTP_HASH_SECRET=

# --- AIプロバイダー動作設定（任意。未設定時は下記デフォルト値が使用される） ---
# 使用するAIプロバイダーをカンマ区切りで指定（例: gpt-4o,claude,gemini）。未設定時は全プロバイダー有効
ENABLED_AI_PROVIDERS=
# 各プロバイダーで使用するモデル名（未設定時のデフォルト値を右側に記載）
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_MODEL=gemini-3.6-flash
# 2026-07-30公式確認: claude-3-haiku-20240307はRetired済み。輸出管理という法令判断
# 支援用途では原価(1案件0.25円程度)よりも精度を優先すべきとの経営判断に基づき、
# 公式が「speed and intelligenceのベストバランス」と位置付けるclaude-sonnet-5
# （導入価格 入力$2/MTok・出力$10/MTok、2026-08-31まで。以降は標準価格$3/$15）
# を採用した（最速最安のclaude-haiku-4-5-20251001や最上位のclaude-opus-5は
# 過剰/役割不一致と判断）。
# 2026-07-30実測（課金アカウント紐付け済みキーで検証、課金アカウント未紐付け時は
# 429 limit:0でモデル解決前にクォータエラーになるため要注意）:
# gemini-1.5-flash / gemini-2.0-flash / gemini-2.5-flash / gemini-2.5-pro /
# gemini-3-pro-preview は404(NOT_FOUND、廃止済み)。gemini-pro-latest /
# gemini-3.5-flashは503(UNAVAILABLE)。ListModels一覧に載っていても実際に
# generateContentが成功するとは限らないため、必ず実呼び出しで確認すること。
# 実際に成功したのはgemini-flash-latest / gemini-3.6-flash / gemini-3.1-pro-preview /
# gemini-3-flash-previewの4つ。このうちgemini-3.6-flashを既定に採用した理由は、
# (1)公式モデル一覧でPreviewでなくStable扱い、(2)gemini-flash-latest等の
# Latestエイリアスは将来無告知でホットスワップされ得るため、輸出管理という
# 法令判断の監査可能性・再現性の観点で不採用とした、(3)実測でHTTP 200を
# 複数回確認済み、という理由による。単価は入力$1.50/MTok・出力$7.50/MTok
# (thinking込み)。詳細はdocs/api-cost-estimate.mdを参照。
# --- AIプロバイダーのタイムアウト設定（すべて任意。ミリ秒） ---
# 呼び出し用途ごとにタイムアウトを分離している。用途別envが最優先、次に
# 下記の共通env（全用途を一律に上書き、後方互換用）、どちらも未設定なら
# 用途別デフォルト値が使われる。
#   - health: 管理画面の疎通診断ping。デフォルト8000ms（遅いと管理画面が固まるため短め）
#   - analysis: 案件のリスク調査・ナラティブ生成。gpt-4o等が長文の構造化JSONを
#     返すのに時間を要するためデフォルト50000ms（実測37.9秒に対し旧45000msでは
#     余裕8秒(17%)しかなく不足していたため引き上げ）
#   - chat: AI相談室（チャット）。デフォルト30000ms
# 各プロバイダーで {PREFIX}_HEALTH_TIMEOUT_MS / {PREFIX}_ANALYSIS_TIMEOUT_MS /
# {PREFIX}_CHAT_TIMEOUT_MS が使用可能（PREFIX = OPENAI / ANTHROPIC / GOOGLE）。
# 例:
# OPENAI_HEALTH_TIMEOUT_MS=8000
# OPENAI_ANALYSIS_TIMEOUT_MS=50000
# OPENAI_CHAT_TIMEOUT_MS=30000
# ANTHROPIC_HEALTH_TIMEOUT_MS=8000
# ANTHROPIC_ANALYSIS_TIMEOUT_MS=50000
# ANTHROPIC_CHAT_TIMEOUT_MS=30000
# GOOGLE_HEALTH_TIMEOUT_MS=8000
# GOOGLE_ANALYSIS_TIMEOUT_MS=50000
# GOOGLE_CHAT_TIMEOUT_MS=30000
#
# 共通env（後方互換。設定すると当該プロバイダーの全用途のデフォルトを一律上書きする。
# 用途別envが設定されていればそちらが優先される）
OPENAI_TIMEOUT_MS=
ANTHROPIC_TIMEOUT_MS=
GOOGLE_TIMEOUT_MS=
#
# 調査エンドツーエンドの総予算タイムアウト（ミリ秒、未設定時は55000）。
# 「3プロバイダー並列調査」+「その後直列実行されるレポートナレーション生成」を
# 合わせた合計の上限。個別プロバイダーのタイムアウトが機能しない場合の保険でもある。
# 重要: 個別プロバイダーのanalysisタイムアウト(既定45000ms) < この値(既定55000ms)
# < 調査APIルートのmaxDuration(60秒、src/app/api/investigations/[id]/run/route.ts)
# の大小関係を必ず維持すること。崩れると内側のタイムアウトが機能する前に
# 外側が先に切れてしまう。55000msと60秒の差5秒はDB保存等AI呼び出し以外の
# 処理時間のバッファ。
INVESTIGATION_TOTAL_TIMEOUT_MS=55000
#
# レポートナレーション生成に最低限確保する時間（ミリ秒、未設定時は12000）。
# 調査フェーズ(3プロバイダー並列)が総予算をほぼ使い切った場合でも、narrative
# 呼び出しが即座にタイムアウトして毎回フォールバック文になってしまわないよう
# 下限を設ける。
NARRATIVE_MIN_TIMEOUT_MS=12000

# --- AI APIコスト暴走ガード（レート制限、すべて任意） ---
# AI実行API（/api/assistant, /api/investigations/[id]/run）に対し、利用者
# （認証済みはメールアドレス単位、匿名はIPハッシュ単位）ごとに短時間窓制限と
# 日次上限を適用する。未設定時は下記の保守的なデフォルト値が使用される。
# 不正な値（数値でない・最小許容値未満）は無視され、デフォルト値にフォールバックする
# （詳細: src/lib/ai/rate-limit.ts）。
#
# 短時間窓の長さ（ミリ秒、未設定時は60000=1分）
AI_RATE_LIMIT_WINDOW_MS=60000
# 認証済み利用者が上記の窓あたりに実行できるAIリクエスト数の上限（未設定時は5）
AI_RATE_LIMIT_MAX_PER_WINDOW=5
# 匿名利用者（IPハッシュ単位）が上記の窓あたりに実行できるAIリクエスト数の上限（未設定時は2）
AI_RATE_LIMIT_ANON_MAX_PER_WINDOW=2
# 認証済み利用者が1日（UTC日付基準）に実行できるAIリクエスト数の上限（未設定時は50）
AI_RATE_LIMIT_DAILY_MAX=50
# 匿名利用者（IPハッシュ単位）が1日（UTC日付基準）に実行できるAIリクエスト数の上限（未設定時は8）
AI_RATE_LIMIT_ANON_DAILY_MAX=8
# 匿名利用者のIPをハッシュ化する際に使うHMAC-SHA256の秘密鍵（任意）。
# 未設定時はSESSION_SECRETを流用し、それも未設定の場合は固定の開発用フォールバック値を
# 使用する（本番環境では安全でないため起動時にコンソール警告が出る）。
# 本番では十分な長さのランダム値を設定すること。
RATE_LIMIT_HASH_SECRET=
