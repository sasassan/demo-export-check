NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=ern_session_email
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/export_risk_navi

# --- エラー監視（Sentry） ---
# サーバー/Edgeランタイム用。
SENTRY_DSN=
# ブラウザ用（NEXT_PUBLIC_ プレフィックス必須）。SENTRY_DSN と同じDSN値を設定。
NEXT_PUBLIC_SENTRY_DSN=

# AI相談室のURL取得を許可するホスト（カンマ区切り）。未設定時は外部URL取得を無効化（SSRF対策）。
# 設定例: ASSISTANT_URL_ALLOWED_HOSTS=www.meti.go.jp,www.cistec.or.jp
ASSISTANT_URL_ALLOWED_HOSTS=

# お問い合わせフォームのメール送信（Resend）。未設定の場合はお問い合わせ送信がfail-closedで拒否される。
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM_EMAIL=
